# AI 摘要配置（提取简介和经典句子）
# 支持 OpenAI / DeepSeek / 本地 Ollama 等 OpenAI 兼容 API

# LLM API Key（必填，不配置则使用规则评分提取）
LLM_API_KEY=

# API 地址（默认 OpenAI）
# DeepSeek: https://api.deepseek.com/v1
# 本地 Ollama: http://localhost:11434/v1
LLM_API_BASE=https://api.openai.com/v1

# 模型名称
# DeepSeek: deepseek-chat
# Ollama: 使用本地模型名，如 qwen2.5:7b
LLM_MODEL=gpt-4o-mini

# 经典句子最大数量（默认20）
MAX_CLASSIC_SENTENCES=20

# 代理配置（可选，也可在应用设置中配置）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 在线发布配置（可选）
# Cloudflare Pages 项目名（需先安装 wrangler: npm install -g wrangler）
# CF_PAGES_PROJECT=my-subtitles
# GitHub 仓库地址（用于 gh-pages 部署）
# GITHUB_PAGES_REPO=https://github.com/username/repo.git
